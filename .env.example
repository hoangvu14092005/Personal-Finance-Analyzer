APP_ENV=local
LOG_LEVEL=INFO

# API
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Frontend
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
E2E_BASE_URL=http://localhost:3100

# Database / queue
POSTGRES_DB=pfa
POSTGRES_USER=pfa
POSTGRES_PASSWORD=pfa
DATABASE_URL=postgresql+psycopg://pfa:pfa@localhost:5433/pfa
REDIS_URL=redis://localhost:6379/0

# Storage / MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=pfa-receipts
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PRIVATE=pfa-receipts
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=data/receipts

# Auth/session
JWT_SECRET=change-me-in-prod-please-use-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=pfa_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# OCR: mock | llm_vision
OCR_PROVIDER=mock
OCR_TIMEOUT_MS=8000
OCR_MAX_FILE_SIZE_MB=10

# Chat LLM / OCR vision endpoint
CHAT_LLM_BASE_URL=http://localhost:20128/v1
CHAT_LLM_API_KEY=sk-your-key-here
CHAT_LLM_MODEL=cx/gpt-5.5
CHAT_LLM_TIMEOUT_SECONDS=60
CHAT_MAX_HISTORY_MESSAGES=40
CHAT_RATE_LIMIT_PER_MINUTE=10

# Legacy insight provider
INSIGHT_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=http://localhost:20128/v1
OPENAI_COMPAT_API_KEY=sk-your-key-here
OPENAI_COMPAT_MODEL=cx/gpt-5.5

# Tests
PFA_SKIP_EMBEDDING=0
